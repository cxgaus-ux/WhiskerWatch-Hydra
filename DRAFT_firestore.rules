rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidRequestContext() {
      return request.time != null;
    }

    function isValidHydraDatasetRecord(data, docId) {
      return isValidId(docId)
        && data.id is string
        && data.id == docId
        && data.datasetId is string
        && data.datasetId.size() >= 1
        && data.datasetId.size() <= 120;
    }

    // Connection test document
    match /test/{docId} {
      allow get: if isValidId(docId);
    }

    // Collection: /cats/{catId}
    match /cats/{catId} {
      allow get, list: if isValidRequestContext();
      allow create, update: if isValidHydraDatasetRecord(incoming(), catId);
      allow delete: if isValidId(catId);
    }

    // Collection: /colonies/{colonyId}
    match /colonies/{colonyId} {
      allow get, list: if isValidRequestContext();
      allow create, update: if isValidHydraDatasetRecord(incoming(), colonyId);
      allow delete: if isValidId(colonyId);
    }

    // Collection: /observations/{observationId}
    match /observations/{observationId} {
      allow get, list: if isValidRequestContext();
      allow create, update: if isValidHydraDatasetRecord(incoming(), observationId);
      allow delete: if isValidId(observationId);
    }

    // Collection: /locations/{locationId}
    match /locations/{locationId} {
      allow get, list: if isValidRequestContext();
      allow create, update: if isValidHydraDatasetRecord(incoming(), locationId);
      allow delete: if isValidId(locationId);
    }

    // Collection: /alerts/{alertId}
    match /alerts/{alertId} {
      allow get, list: if isValidRequestContext();
      allow create, update: if isValidHydraDatasetRecord(incoming(), alertId);
      allow delete: if isValidId(alertId);
    }

    // Collection: /care_episodes/{careEpisodeId}
    match /care_episodes/{careEpisodeId} {
      allow get, list: if isValidRequestContext();
      allow create, update: if isValidHydraDatasetRecord(incoming(), careEpisodeId);
      allow delete: if isValidId(careEpisodeId);
    }

    // Collection: /photos/{photoId}
    match /photos/{photoId} {
      allow get, list: if isValidRequestContext();
      allow create, update: if isValidHydraDatasetRecord(incoming(), photoId);
      allow delete: if isValidId(photoId);
    }

    // Collection: /sightings/{sightingId}
    match /sightings/{sightingId} {
      allow get, list: if isValidRequestContext();
      allow create, update: if isValidId(sightingId) && incoming().catId is string && incoming().catId.size() <= 128;
      allow delete: if isValidId(sightingId);
    }

    // Collection: /stations/{stationId}
    match /stations/{stationId} {
      allow get, list: if isValidRequestContext();
      allow create, update: if isValidId(stationId) && incoming().stationName is string && incoming().stationName.size() <= 128;
      allow delete: if isValidId(stationId);
    }
  }
}
